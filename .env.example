# ────────────────────────────────────────────
# Nagpur Ride Platform — Environment Variables
# Copy this to .env and fill in the values.
# ────────────────────────────────────────────

# ── Required ──────────────────────────────

# PostgreSQL connection string (required in production, optional in dev where memory store is used)
DATABASE_URL=postgres://ride:ride@localhost:5432/ride

# Signing key for access tokens (HMAC-SHA256). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SIGNING_KEY=change-me-to-a-random-hex-string

# ── Staff / Admin ─────────────────────────

# Comma-separated phone:ROLE pairs. Staff roles are granted ONLY by this server-side allow-list.
# Roles: SUPPORT, OPS_ADMIN, FINANCE_ADMIN, SUPER_ADMIN
ADMIN_PHONES=+919000000001:OPS_ADMIN,+919000000002:SUPER_ADMIN

# ── Payments ──────────────────────────────

# Webhook signature secret (for verifying payment provider callbacks)
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret

# ── Server ────────────────────────────────

PORT=3000
NODE_ENV=development

# PostgreSQL connection pool size
PG_POOL_MAX=10

# ── Dev Tools ─────────────────────────────

# Set to 1 to enable the fake-pay endpoint (POST /api/v1/dev/fake-pay/:ref)
ENABLE_DEV_TOOLS=1

# ── Optional (future) ────────────────────

# SMS/OTP provider credentials (required in production)
# OTP_PROVIDER=msg91
# OTP_API_KEY=

# Maps provider (required for routing, ETA, geocoding)
# MAPS_PROVIDER=google
# MAPS_API_KEY=

# Push notification provider
# PUSH_PROVIDER=expo
# PUSH_ACCESS_TOKEN=

# Object storage for driver documents
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=
# STORAGE_REGION=

# Path to the built admin console SPA (default: auto-detected relative to api)
# ADMIN_UI_DIR=
